# ── Supabase (required for real online/multi-device login) ──────────────────
# Get these from your Supabase project: Project Settings -> API
#   - Project URL            -> NEXT_PUBLIC_SUPABASE_URL
#   - Project API keys > anon / public -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# Both MUST be prefixed with NEXT_PUBLIC_ because they're read in the browser
# (src/lib/supabase.ts). The anon key is safe to expose publicly — it's
# designed for client-side use and is protected by your Row Level Security
# policies, NOT by keeping it secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Gemini AI (optional — only needed for the AI Retailer / /ai page) ───────
# Get this from https://aistudio.google.com/apikey
# This one is server-only (no NEXT_PUBLIC_ prefix) — used in
# src/app/api/ai/recommend/route.ts and never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key
